# Required in production. Generate one with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Optional: GitHub sign-in. Callback URL: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional: Google sign-in. Callback URL: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: set to "false" to hide the password-less demo account.
AUTH_DEMO_LOGIN=true

# Optional: canonical site URL for metadata and the sitemap (defaults to the Vercel production URL).
NEXT_PUBLIC_SITE_URL=
